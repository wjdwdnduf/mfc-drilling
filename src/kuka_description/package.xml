<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_description</name>
  <version>1.0.0</version>
  <description>
    URDF/xacro description of the KUKA KR300 R2700 with the drilling tool and
    the end-effector RealSense mount, plus visual meshes and the RViz layout
    used in the paper.
  </description>
  <maintainer email="MAINTAINER_EMAIL">Juyeol Jeong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- urdf/realsense_camera.xacro does
       <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro"/>
       so the description does not expand without this package. It was
       previously undeclared, which made the xacro fail on a fresh clone. -->
  <exec_depend>realsense2_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
