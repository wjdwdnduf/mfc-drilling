<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kuka">

    <xacro:property name="PI" value="3.14159265359" />
    <xacro:property name="DEG2RAD" value="0.01745329251" />
    <xacro:property name="effort" value="30.0" />
    <xacro:property name="velocity" value="10.0" />    
    <xacro:include filename="$(find kuka_description)/urdf/realsense_camera.xacro" />
    <xacro:macro name="default_inertial" params="mass">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}" />
            <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                     iyy="1.0" iyz="0.0"
                     izz="1.0" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="default_transmission" params="number">
        <transmission name="transmission_${number}">
            <plugin>transmission_interface/SimpleTransmission</plugin>
            <actuator name="motor_${number}" role="actuator1"/>
            <joint name="joint_${number}"    role="joint1">
                <mechanical_reduction>1.0</mechanical_reduction>
            </joint>
        </transmission>
    </xacro:macro>
    
    <!-- Links -->
    <link name="world"/>

    <link name="base_link">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link0_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link0_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="link_1">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="-${PI/2} 0 ${PI}" xyz="0.33 0 -0.67"/> 
            <geometry>
                <mesh filename="package://kuka_description/meshes/link1_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0.9607 0.4117 0.0549 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="-${PI/2} 0 ${PI}" xyz="0.33 0 -0.67"/> 
            <geometry>
                <mesh filename="package://kuka_description/meshes/link1_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="link_2">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="0 0 ${-2*DEG2RAD}" xyz="1.176 -0.015 0.1"/> 
            <geometry>
                <mesh filename="package://kuka_description/meshes/link2_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0.9607 0.4117 0.0549 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 ${-2*DEG2RAD}" xyz="1.176 -0.015 0.1"/> 
            <geometry>
                <mesh filename="package://kuka_description/meshes/link2_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="link_3">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 -0.15 0.01"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link3_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0.9607 0.4117 0.0549 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 -0.15 0.01"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link3_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="link_4">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="-${PI/2} 0 0" xyz="0 0 -1.2"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link4_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0.9607 0.4117 0.0549 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="-${PI/2} 0 0" xyz="0 0 -1.2"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link4_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>
    
    <link name="link_5">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 0 -0.01"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link5_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0.9607 0.4117 0.0549 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="${PI/2} 0 ${PI/2}" xyz="-0.03 0 -0.01"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link5_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>
    
    <link name="link_6">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="0 0 ${PI}" xyz="0 0 0.02"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link6_exp.stl" scale="1 1 1"/>
            </geometry>
            <material name="">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 ${PI}" xyz="0 0 0.02"/>
            <geometry>
                <mesh filename="package://kuka_description/meshes/link6_exp.stl" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <!-- Joints -->  
    <!-- Joint Limit Should be justified -->  
    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint> 
    
    <joint name ="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link = "link_1"/>
        <origin rpy="${PI} 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${185*DEG2RAD}" upper="${185*DEG2RAD}" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>
    
    <joint name ="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link = "link_2"/>
        <origin rpy="${PI / 2} 0 0" xyz="0.33 0 -0.645"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${140*DEG2RAD}" upper="-${5*DEG2RAD}"  
               effort="${effort}" velocity="${velocity}"/> 
    </joint>

    <joint name ="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link = "link_3"/>
        <origin rpy="0 0 0" xyz="1.150 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${120*DEG2RAD}" upper="${168*DEG2RAD}" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name ="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link = "link_4"/>
        <origin rpy="${PI/2} 0 -${PI/2}" xyz="0 -0.115 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${350*DEG2RAD}" upper="${350*DEG2RAD}" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>

    <joint name ="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link = "link_5"/>
        <origin rpy="-${PI/2} ${PI/2} 0" xyz="0 0 -1.220"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${122.5*DEG2RAD}" upper="${122.5*DEG2RAD}" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>
    
    <joint name ="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link = "link_6"/>
        <origin rpy="${PI/2} 0 -${PI/2}" xyz="0.24 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-${350*DEG2RAD}" upper="${350*DEG2RAD}" 
               effort="${effort}" velocity="${velocity}"/>
    </joint> 











    <!-- 이 아래만 불명확 -->







    <!-- Gripper links -->
    <link name="end_effector_link">
        <xacro:default_inertial mass="0.1" />
        <visual>
            <origin xyz="-0.075 0 -0.0085" rpy="0 0 0" />
            <!--origin xyz="0.1125 0 0" rpy="0 0 0" /-->
            <geometry>
                <box size="0.3 0.225 0.225" /> <!-- x, y, z 방향 크기 지정 -->
            </geometry>
            <material name="">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <!-- <origin xyz="0.1125 0 0" rpy="0 0 0" /> -->
            <origin xyz="-0.075 0 -0.0085" rpy="0 0 0" />
            <geometry>
                <box size="0.3 0.225 0.225" /> <!-- x, y, z 방향 크기 지정 -->
            </geometry>
        </collision>
    </link>
    
    <joint name="end_effector_joint" type="revolute">
        <parent link="link_6" />
        <child link="end_effector_link" />
        <!-- <origin xyz="0 0 -0.075" rpy="${PI} -${PI/2} ${PI/18}" />  -->
        <origin xyz="0 0 -0.075" rpy="${PI} -${PI/2} -${PI/360}" /> 
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="0" 
               effort="${effort}" velocity="${velocity}"/>
    </joint>
    
    <link name="drill_link">
        <xacro:default_inertial mass="0.05" />
        <visual>
            <!--실제 드릴 위치와 같도록 조절 필요.-->
            <!-- <origin xyz="0 0 0.05" rpy="0 0 0" /> -->
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
            <material name="">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <!-- <origin xyz="0 0 0.05" rpy="0 0 0" /> -->
            <origin xyz="0 0 0.05" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </collision>
    </link>
    
    <joint name="drill_joint" type="fixed">
        <parent link="end_effector_link" />
        <child link="drill_link" />
        <!-- <origin xyz="0 0 -0.255" rpy="0 0 ${PI}" /> -->
        <!-- <origin xyz="-0.225+13 0 -0.255" rpy="0 0 ${PI}" /> -->
        <origin xyz="-0.212 0 -0.255" rpy="0 0 ${PI}" /> 
    </joint>

    
</robot>