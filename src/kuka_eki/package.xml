<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_eki</name>
  <version>1.0.0</version>
  <description>
    Communication layer between ROS 2 and a KUKA controller over EKI
    (Ethernet KRL Interface). Provides the kuka_joint service, publishes
    /joint_states, and exposes spindle on/off as a service.
  </description>
  <maintainer email="MAINTAINER_EMAIL">Juyeol Jeong</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>kuka_control_box_srvs</depend>
  <depend>python3-numpy</depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>kuka_description</exec_depend>
  <exec_depend>kuka_control_box</exec_depend>
  <exec_depend>kuka_task_client</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
