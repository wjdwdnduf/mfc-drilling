<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_task_client</name>
  <version>1.0.0</version>
  <description>
    Task layer for the MFC drilling pipeline: parses commands from
    /kuka/command, detects drill targets, converts pixels to base-frame 3D
    points, and drives the IK service. Also estimates the workpiece plane
    normal from the RGB-D stream.
  </description>
  <maintainer email="MAINTAINER_EMAIL">Juyeol Jeong</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>kuka_control_box_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- open3d is pip-only; see README for the install step. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
