<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_control_box</name>
  <version>1.0.0</version>
  <description>
    Analytic inverse kinematics for the KUKA KR300 R2700. Provides the
    kuka_transform_input service: takes a Cartesian end-effector pose, solves
    IK seeded with the current joint state, and forwards the result to the
    kuka_joint service.
  </description>
  <maintainer email="MAINTAINER_EMAIL">Juyeol Jeong</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>
  <depend>kuka_control_box_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <!-- Required by CMakeLists.txt but previously undeclared, so rosdep could
       not resolve them and build order was not guaranteed. -->
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
